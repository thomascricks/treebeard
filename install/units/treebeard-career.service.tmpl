[Unit]
Description=Treebeard daily governed career hunter (Han job search)
[Service]
Environment=TREEBEARD_BASE=@TB_BASE@
Environment=TREEBEARD_ETC=@TB_ETC@
Type=oneshot
User=@TB_USER@
Group=@TB_GROUP@
EnvironmentFile=@TB_ETC@/credentials/providers.env
EnvironmentFile=-@TB_ETC@/credentials/treebeard.env
ExecStart=@TB_BASE@/shared/venv/bin/python3 @TB_BASE@/shared/lib/career_hunter_daily.py
