# ==== TREEBEARD EXAMPLE CREDENTIALS =========================================
# Install:  $TREEBEARD_ETC/credentials/providers.env   (root:root 0600)
# Loaded by systemd units via EnvironmentFile=. Names only here -- NEVER commit
# a filled copy. Every key is OPTIONAL: a missing key disables that provider's
# tier fail-closed (the router logs a key-skip, it never invents a call).
# ===========================================================================

# --- model providers (each enables one routing tier) -----------------------
TREEBEARD_FRONTIER_API_KEY=   # frontier tier
TREEBEARD_ADVANCED_A_API_KEY= # advanced_a tier
TREEBEARD_ADVANCED_B_API_KEY= # advanced_b tier
TREEBEARD_FREE_API_KEY=       # free tier; also used by sun/moon daily jobs
TREEBEARD_CHEAP_API_KEY=      # cheap tier (OpenAI-compatible endpoint)

# --- operator gates (usually set in the unit or treebeard.env, not here) ----
# Contract: unset => granted; 1/true/yes/on => granted; 0/false/no/off =>
# operator veto; empty or malformed => DENIED (fail-closed, stderr warning).
# TREEBEARD_FRONTIER_ENABLED=
# TREEBEARD_ADVANCED_A_ENABLED=
# TREEBEARD_ADVANCED_B_ENABLED=
# TREEBEARD_CHEAP_ENABLED=

# --- web search (career_search tool; toolbox door) -------------------------
BRAVE_API_KEY=                # required for live search; absent => search ships dark
SERPER_API_KEY=               # URL enrichment (optional)
SERPAPI_API_KEY=              # google_jobs engine for Clark intake (optional)

# --- email (Resend) ----------------------------------------------------------
RESEND_API_KEY=               # outbound digests (send-only key is sufficient)
RESEND_INBOUND_API_KEY=       # Clark forwarded-email intake (needs inbound read)
RESEND_FROM=                  # verified sender address
DIGEST_TO=                    # operator mailbox that receives digests

# --- outbound proxy (optional; unused unless your host needs it) -------------
WEBSHARE_USER=
WEBSHARE_PASS=
WEBSHARE_PROXIES=

# --- tier endpoint bases (optional; unset => tier stays dark) --------------
TREEBEARD_FREE_API_BASE=         # free-tier OpenAI-compatible endpoint root
TREEBEARD_CHEAP_API_BASE=        # cheap-tier endpoint root
TREEBEARD_ADVANCED_A_API_BASE=   # advanced_a-tier endpoint root
TREEBEARD_ADVANCED_B_API_BASE=   # advanced_b-tier endpoint root
