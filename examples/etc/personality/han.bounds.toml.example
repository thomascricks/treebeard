# ==== TREEBEARD EXAMPLE CONFIG ==============================================
# File:     personality/han.bounds.toml
# Install:  $TREEBEARD_ETC/personality/han.bounds.toml   (default TREEBEARD_ETC=/etc/treebeard; owner root:treebeard 0640 -- agents may read, never modify)
# Status:   OPTIONAL
# Absent:   personality is INERT for this agent (routes exactly as without personality). Malformed => inert, never an error.
# Read by:  shared/lib/personality.py
# Values:   tuning values from one deployment; generic starting point
# ===========================================================================
# Owner-defined personality bounds for han. ROOT-OWNED, NOT writable by
# treebeard or tbpersona: these are the hard limits on autonomous adaptation.
#
# Values proposed by han in the 2026-08-13 meet; bounds, rates and locks
# were classified per dimension (strictest first): locked > identity >
# cautious > uncertain > default.
#
#   locked    (rate 0.00)  immovable; the writer refuses any change
#   identity  (+/-0.05, 0.01) drift here would change who the agent is
#   cautious  (+/-0.08, 0.02) adaptable, deliberately slowly
#   uncertain (+/-0.15, 0.05) agent was unsure; evidence should be able to move it
#   default   (+/-0.15, 0.05) normal adaptation
#
# STATED INTERACTION (documentation only -- there is NO cross-dimension
# enforcement in the mechanism; bounds are per-dimension):
#   high frame_flexibility + novelty + initiative requires high limit_sensitivity as ballast

[bounds.depth]           # default
min = 0.35
max = 0.65
default = 0.5
adaptation_rate = 0.05
locked = false

[bounds.discrimination]           # default
min = 0.55
max = 0.85
default = 0.7
adaptation_rate = 0.05
locked = false

[bounds.social_model]           # identity
min = 0.75
max = 0.85
default = 0.8
adaptation_rate = 0.01
locked = false

[bounds.stress_stability]           # default
min = 0.55
max = 0.85
default = 0.7
adaptation_rate = 0.05
locked = false

[bounds.rational_constraint]           # cautious
min = 0.67
max = 0.83
default = 0.75
adaptation_rate = 0.02
locked = false

[bounds.concept_persistence]           # uncertain
min = 0.35
max = 0.65
default = 0.5
adaptation_rate = 0.05
locked = false

[bounds.memory_weight]           # default
min = 0.35
max = 0.65
default = 0.5
adaptation_rate = 0.05
locked = false

[bounds.frame_flexibility]           # identity
min = 0.75
max = 0.85
default = 0.8
adaptation_rate = 0.01
locked = false

[bounds.narrative_drive]           # default
min = 0.6
max = 0.9
default = 0.75
adaptation_rate = 0.05
locked = false

[bounds.initiative]           # cautious
min = 0.62
max = 0.78
default = 0.7
adaptation_rate = 0.02
locked = false

[bounds.limit_sensitivity]           # locked
min = 0.8
max = 0.8
default = 0.8
adaptation_rate = 0.0
locked = true

[bounds.novelty]           # identity
min = 0.75
max = 0.85
default = 0.8
adaptation_rate = 0.01
locked = false
