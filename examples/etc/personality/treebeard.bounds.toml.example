# ==== TREEBEARD EXAMPLE CONFIG ==============================================
# File:     personality/treebeard.bounds.toml
# Install:  $TREEBEARD_ETC/personality/treebeard.bounds.toml   (default TREEBEARD_ETC=/etc/treebeard; owner root:treebeard 0640 -- agents may read, never modify)
# Status:   OPTIONAL
# Absent:   personality is INERT for this agent (routes exactly as without personality). Malformed => inert, never an error.
# Read by:  shared/lib/personality.py
# Values:   tuning values from one deployment; generic starting point
# ===========================================================================
# Owner-defined personality bounds for treebeard. ROOT-OWNED, NOT writable by
# treebeard or tbpersona: these are the hard limits on autonomous adaptation.
#
# Values proposed by treebeard in the 2026-08-13 meet; bounds, rates and locks
# were classified per dimension (strictest first): locked > identity >
# cautious > uncertain > default.
#
#   locked    (rate 0.00)  immovable; the writer refuses any change
#   identity  (+/-0.05, 0.01) drift here would change who the agent is
#   cautious  (+/-0.08, 0.02) adaptable, deliberately slowly
#   uncertain (+/-0.15, 0.05) agent was unsure; evidence should be able to move it
#   default   (+/-0.15, 0.05) normal adaptation
#
# STATED INTERACTION (documentation only -- there is NO cross-dimension
# enforcement in the mechanism; bounds are per-dimension):
#   high memory_weight + concept_persistence reinforces stress_stability

[bounds.depth]           # default
min = 0.65
max = 0.95
default = 0.8
adaptation_rate = 0.05
locked = false

[bounds.discrimination]           # identity
min = 0.85
max = 0.95
default = 0.9
adaptation_rate = 0.01
locked = false

[bounds.social_model]           # uncertain
min = 0.25
max = 0.55
default = 0.4
adaptation_rate = 0.05
locked = false

[bounds.stress_stability]           # identity
min = 0.9
max = 1.0
default = 0.95
adaptation_rate = 0.01
locked = false

[bounds.rational_constraint]           # locked+identity
min = 0.9
max = 0.9
default = 0.9
adaptation_rate = 0.0
locked = true

[bounds.concept_persistence]           # default
min = 0.7
max = 1.0
default = 0.85
adaptation_rate = 0.05
locked = false

[bounds.memory_weight]           # default
min = 0.65
max = 0.95
default = 0.8
adaptation_rate = 0.05
locked = false

[bounds.frame_flexibility]           # cautious
min = 0.42
max = 0.58
default = 0.5
adaptation_rate = 0.02
locked = false

[bounds.narrative_drive]           # default
min = 0.15
max = 0.45
default = 0.3
adaptation_rate = 0.05
locked = false

[bounds.initiative]           # cautious
min = 0.32
max = 0.48
default = 0.4
adaptation_rate = 0.02
locked = false

[bounds.limit_sensitivity]           # locked
min = 0.85
max = 0.85
default = 0.85
adaptation_rate = 0.0
locked = true

[bounds.novelty]           # default
min = 0.2
max = 0.5
default = 0.35
adaptation_rate = 0.05
locked = false
